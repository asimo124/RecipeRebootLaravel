APP_NAME="Recipe Book"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rcpapi.hawleywebdesign.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recipes
DB_USERNAME=recipes
DB_PASSWORD=change-me

# Recipe book ri_* tables. Install postgresql + php8.2-pgsql on Debian.
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=recipes
PGSQL_USERNAME=recipes
PGSQL_PASSWORD=change-me
PGSQL_SSLMODE=prefer

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SANCTUM_EXPIRATION=43200

CORS_ALLOWED_ORIGINS=https://rcp.hawleywebdesign.com

ADMIN_NAME="Alex H."
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
